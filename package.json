{
  "name": "score-widget",
  "productName": "學生加分小工具",
  "version": "7.3.0",
  "description": "置頂在桌面上的學生加分小工具",
  "author": "蔡爾源",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tw.huwei.scorewidget",
    "productName": "學生加分小工具",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "ScoreWidget-${version}.exe"
    }
  }
}
